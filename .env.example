# ============================================================
#  Fleet Manager — Environment Variables
#  Copy this file to .env and fill in real values.
#  .env is listed in .gitignore and must NEVER be committed.
# ============================================================

# --- JWT ---
# HS256 signing key. Must be at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Token lifetime in seconds (default 24 h = 86400)
JWT_EXPIRATION_SECONDS=86400

# --- Default Admin Seed User ---
# Created automatically on first startup if it does not already exist.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEFAULT_ADMIN_ROLE=ADMIN
